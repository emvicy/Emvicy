#-------------------------------------------------------------------------------
# Emvicy
# apache .htaccess file

# activate rewrite Rules
RewriteEngine On

# prevent httpd from serving dotfiles (.htaccess, .svn, .git, etc.)
RedirectMatch 403 /\..*$

#-------------------------------------------------------------------------------

# pass-through files
RewriteCond %{REQUEST_FILENAME} !-f

# forward to index.php
RewriteRule .* index.php
